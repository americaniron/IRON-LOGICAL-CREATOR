# Application Environment
NODE_ENV=production
APP_ENV=production
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/iron_logical_creator
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iron_logical_creator
DB_USER=username
DB_PASSWORD=password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Authentication & Security
JWT_SECRET=your-strong-random-secret-here-min-32-chars
SESSION_SECRET=your-strong-session-secret-here-min-32-chars
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Trust Proxy (set to true when behind Cloudflare or other proxies)
TRUST_PROXY=false

# Base URLs
BASE_URL=http://localhost:3001
PUBLIC_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# External API Keys (User-provided, not stored in backend)
# Users will be prompted for these in the UI
# GEMINI_API_KEY - User provides in UI
# OPENAI_API_KEY - User provides in UI
# GROK_API_KEY - User provides in UI

# Admin Default Credentials (Change in production!)
ADMIN_DEFAULT_PIN=01970
ADMIN_DEFAULT_NAME=COMMANDER_Z
ADMIN_INITIAL_CREDITS=999999
